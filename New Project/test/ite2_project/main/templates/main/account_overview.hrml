{% extends "main/admin_panel.html" %}

{% block title %}Account Overview{% endblock %}

{% block content %}
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">Account Overview</h1>
    <p class="mt-1 text-sm text-slate-500">Update your account information, password, profile picture, and login PIN.</p>
</div>

<form method="POST" enctype="multipart/form-data" class="space-y-6">
    {% csrf_token %}

    <section class="card p-6">
        <h2 class="mb-5 text-lg font-bold text-slate-900">
            <i class="fa-solid fa-user mr-2 text-orange-500"></i>
            Personal Information
        </h2>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label class="mb-2 block text-sm font-semibold">Username</label>
                {{ form.username }}
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">Email</label>
                {{ form.email }}
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">First Name</label>
                {{ form.first_name }}
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">Last Name</label>
                {{ form.last_name }}
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">Contact Number</label>
                {{ form.contact_number }}
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">Profile Picture</label>
                {{ form.profile_picture }}
            </div>
            <div class="md:col-span-2">
                <label class="mb-2 block text-sm font-semibold">Address</label>
                {{ form.address }}
            </div>
        </div>
    </section>

    <section class="card p-6">
        <h2 class="mb-5 text-lg font-bold text-slate-900">
            <i class="fa-solid fa-shield-halved mr-2 text-orange-500"></i>
            Security
        </h2>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label class="mb-2 block text-sm font-semibold">Current Password</label>
                {{ form.current_password }}
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">PIN Code</label>
                {{ form.pin_code }}
                <p class="mt-1 text-xs text-slate-500">Leave blank to disable PIN login.</p>
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">New Password</label>
                {{ form.new_password }}
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold">Confirm New Password</label>
                {{ form.confirm_new_password }}
            </div>
        </div>
    </section>

    <div class="flex justify-end">
        <button class="btn-primary">
            <i class="fa-solid fa-floppy-disk mr-2"></i>
            Save Account Changes
        </button>
    </div>
</form>
{% endblock %}
